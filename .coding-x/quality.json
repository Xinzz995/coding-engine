{
  "schemaVersion": 2,
  "codingXVersion": "0.33.3",
  "repository": {
    "provider": "github",
    "fullName": "Xinzz995/coding-engine",
    "defaultBranch": "main"
  },
  "release": {
    "protectedRefs": ["v*"]
  },
  "sources": {
    "specs": [
      {
        "kind": "path",
        "path": "docs/specs/**"
      },
      {
        "kind": "pull-request"
      }
    ],
    "acceptanceCriteria": [
      {
        "kind": "pull-request"
      }
    ],
    "engineeringStandards": [
      "AGENTS.md",
      "docs/golden-principles.md",
      "docs/patterns.md",
      "docs/architecture.md"
    ]
  },
  "modules": [
    {
      "id": "root",
      "path": "."
    }
  ],
  "generatedPaths": ["dist/**", "coverage/**"],
  "localValidation": {
    "prepare": [
      {
        "executable": "npm",
        "args": ["ci"],
        "cwd": ".",
        "platforms": ["linux", "macos", "windows"],
        "timeoutMs": 600000
      }
    ],
    "allowedPaths": ["node_modules/**"]
  },
  "checks": {
    "test": {
      "checks": [
        {
          "id": "tests",
          "module": "root",
          "paths": ["src/**", "build/**", "hooks/**"],
          "command": {
            "executable": "npm",
            "args": ["test", "--", "--run"],
            "cwd": ".",
            "platforms": ["linux", "macos", "windows"],
            "timeoutMs": 1800000
          }
        },
        {
          "id": "legacy-compatibility",
          "module": "root",
          "paths": ["src/workspace-safety/**", "package.json", "package-lock.json"],
          "command": {
            "executable": "npm",
            "args": ["run", "test:legacy-compat"],
            "cwd": ".",
            "platforms": ["linux", "macos", "windows"],
            "timeoutMs": 600000
          }
        },
        {
          "id": "windows-native-proof",
          "module": "root",
          "paths": [
            ".gitattributes",
            "assets/workspace-safety/**",
            "build/compile-windows-test-fixture.ps1",
            "build/run-windows-native-proof.ps1",
            "build/vitest.windows-native.config.mjs",
            "build/windows-native-proof.mjs",
            "vitest.config.ts",
            "src/review/temporary-directory.ts",
            "src/workspace-safety/__fixtures__/**",
            "src/workspace-safety/windows-*.ts",
            "src/workspace-safety/delegated-recovery.windows-crash.test.ts"
          ],
          "command": {
            "executable": "npm",
            "args": ["run", "test:windows-native-proof"],
            "cwd": ".",
            "platforms": ["windows"],
            "timeoutMs": 1200000
          }
        }
      ]
    },
    "build": {
      "checks": [
        {
          "id": "build",
          "module": "root",
          "command": {
            "executable": "npm",
            "args": ["run", "build"],
            "cwd": ".",
            "platforms": ["linux", "macos", "windows"],
            "timeoutMs": 600000
          }
        },
        {
          "id": "windows-supervisor-reproducibility",
          "module": "root",
          "paths": [
            ".gitattributes",
            "native/windows-supervisor/**",
            "assets/workspace-safety/coding-x-windows-supervisor.exe",
            "assets/workspace-safety/WindowsSupervisorProgram.cs",
            "assets/workspace-safety/WindowsJobSupervisor.cs",
            "assets/workspace-safety/WindowsJobProcess.cs",
            "assets/workspace-safety/WindowsJobAuthority.cs"
          ],
          "command": {
            "executable": "pwsh",
            "args": [
              "-NoLogo",
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "native/windows-supervisor/build.ps1",
              "-Mode",
              "Verify",
              "-CommittedExecutable",
              "assets/workspace-safety/coding-x-windows-supervisor.exe"
            ],
            "cwd": ".",
            "platforms": ["windows"],
            "timeoutMs": 600000
          }
        },
        {
          "id": "windows-path-inspector-reproducibility",
          "module": "root",
          "paths": [
            ".gitattributes",
            "native/windows-supervisor/**",
            "assets/workspace-safety/coding-x-windows-path-inspector.exe",
            "assets/workspace-safety/WindowsPathInspectorProgram.cs",
            "assets/workspace-safety/WindowsPathAttributes.cs"
          ],
          "command": {
            "executable": "pwsh",
            "args": [
              "-NoLogo",
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "native/windows-supervisor/build.ps1",
              "-Mode",
              "Verify",
              "-Target",
              "PathInspector",
              "-CommittedExecutable",
              "assets/workspace-safety/coding-x-windows-path-inspector.exe"
            ],
            "cwd": ".",
            "platforms": ["windows"],
            "timeoutMs": 600000
          }
        },
        {
          "id": "cli-smoke",
          "module": "root",
          "command": {
            "executable": "node",
            "args": ["dist/cli.js", "--help"],
            "cwd": ".",
            "platforms": ["linux", "macos", "windows"],
            "timeoutMs": 60000
          }
        }
      ]
    },
    "static": {
      "checks": [
        {
          "id": "format",
          "module": "root",
          "paths": ["src/**", "build/**", "hooks/**", "*.ts", "*.js"],
          "command": {
            "executable": "npm",
            "args": ["run", "format:check"],
            "cwd": ".",
            "platforms": ["linux"],
            "timeoutMs": 120000
          }
        },
        {
          "id": "lint",
          "module": "root",
          "paths": ["src/**", "eslint.config.js", "tsconfig.json"],
          "command": {
            "executable": "npm",
            "args": ["run", "lint"],
            "cwd": ".",
            "platforms": ["linux"],
            "timeoutMs": 600000
          }
        },
        {
          "id": "typecheck",
          "module": "root",
          "paths": ["src/**", "tsconfig.json"],
          "command": {
            "executable": "npm",
            "args": ["run", "typecheck"],
            "cwd": ".",
            "platforms": ["linux", "macos", "windows"],
            "timeoutMs": 600000
          }
        },
        {
          "id": "repository-health",
          "module": "root",
          "paths": [
            ".coding-x/**",
            ".github/ISSUE_TEMPLATE/**",
            ".github/PULL_REQUEST_TEMPLATE.md",
            ".github/workflows/**",
            "AGENTS.md",
            "README.md",
            "docs/**",
            "src/doctor/repository-health.test.ts"
          ],
          "command": {
            "executable": "npm",
            "args": ["run", "repository-health"],
            "cwd": ".",
            "platforms": ["linux", "macos", "windows"],
            "timeoutMs": 120000
          }
        }
      ]
    },
    "security": {
      "checks": [
        {
          "id": "dependency-audit",
          "module": "root",
          "command": {
            "executable": "npm",
            "args": ["audit", "--audit-level=high"],
            "cwd": ".",
            "platforms": ["linux"],
            "timeoutMs": 300000
          }
        }
      ]
    }
  },
  "risk": {
    "defaultCategories": [
      "policy",
      "public-contract",
      "state",
      "migration",
      "recovery",
      "idempotency",
      "concurrency",
      "timeout",
      "retry",
      "subprocess",
      "security",
      "privacy",
      "untrusted-input",
      "cross-module",
      "large-file",
      "reviewer-request",
      "release"
    ],
    "highRiskPaths": [
      ".coding-x/**",
      ".gitattributes",
      ".github/workflows/**",
      ".github/dependabot.yml",
      "assets/workspace-safety/**",
      "native/windows-supervisor/**",
      "src/contracts/**",
      "src/engine/**",
      "src/review/**",
      "src/workspace-safety/**",
      "src/quality/**",
      "src/doctor/**",
      "src/status/**",
      "src/report/**",
      "build/**",
      "hooks/**",
      "eslint.config.js",
      ".prettierrc.json",
      "tsconfig.json",
      "tsup.config.ts",
      "vitest.config.ts",
      "package.json",
      "package-lock.json"
    ],
    "pathRules": [
      {
        "paths": [
          ".coding-x/**",
          ".gitattributes",
          ".github/workflows/**",
          ".github/dependabot.yml",
          "assets/workspace-safety/**",
          "native/windows-supervisor/**",
          "build/compile-windows-test-fixture.ps1",
          "build/run-windows-native-proof.ps1",
          "build/vitest.windows-native.config.mjs",
          "build/windows-native-proof.mjs",
          "build/windows-native-proof.test.mjs",
          "build/workflow-security.test.mjs",
          "build/ordinary-windows-test-loader.test.mjs",
          "eslint.config.js",
          ".prettierrc.json",
          "docs/golden-principles.md",
          "src/doctor/repository-health.test.ts",
          "src/quality/**",
          "src/review/**",
          "src/status/runner-version-observation.ts",
          "src/workspace-safety/__fixtures__/**",
          "src/workspace-safety/cross-process-fixture.test-support.test.ts",
          "src/workspace-safety/cross-process-fixture.test-support.ts",
          "src/workspace-safety/delegated-recovery.windows-crash.test.ts",
          "src/workspace-safety/windows-identity-protocol.ts",
          "src/workspace-safety/windows-identity-test-transport.ts",
          "src/workspace-safety/windows-identity-transport.ts",
          "src/workspace-safety/windows-path-attributes-transport.test.ts",
          "src/workspace-safety/windows-path-attributes-transport.ts",
          "src/workspace-safety/windows-path-attributes.test.ts",
          "src/workspace-safety/windows-path-attributes.ts",
          "src/workspace-safety/windows-reparse-point.windows.test.ts",
          "src/workspace-safety/windows-review-temporary-domain.windows.test.ts",
          "src/workspace-safety/windows-supervisor.crash.test.ts",
          "src/workspace-safety/windows-supervisor-integration.test.ts",
          "src/workspace-safety/windows-supervisor.test.ts",
          "tsconfig.json",
          "vitest.config.ts"
        ],
        "categories": ["policy", "security"]
      },
      {
        "paths": ["src/engine/**"],
        "categories": ["state", "recovery", "concurrency", "timeout", "retry", "subprocess"]
      },
      {
        "paths": ["src/contracts/**"],
        "categories": ["public-contract", "state"]
      },
      {
        "paths": ["src/workspace-safety/**"],
        "categories": [
          "state",
          "recovery",
          "idempotency",
          "concurrency",
          "timeout",
          "subprocess",
          "security",
          "untrusted-input"
        ]
      },
      {
        "paths": [
          "package.json",
          "package-lock.json",
          ".github/workflows/stage-candidate.yml",
          ".github/workflows/publish.yml",
          "tsup.config.ts"
        ],
        "categories": ["release", "security"]
      }
    ]
  },
  "github": {
    "jobs": [
      {
        "id": "ubuntu-node-22",
        "platform": "linux",
        "toolchains": [
          {
            "kind": "node",
            "version": "22",
            "cache": "npm",
            "cacheDependencyPath": "package-lock.json"
          }
        ],
        "setup": [
          {
            "executable": "npm",
            "args": ["ci"],
            "cwd": ".",
            "platforms": ["linux"],
            "timeoutMs": 600000
          },
          {
            "shell": "bash",
            "script": "CODING_X_RUN_LINUX_MOUNT_PROOF=1 npx vitest run src/engine/clean-validation-mounts.test.ts -t 'rejects a real Linux bind mount before recursive cleanup'",
            "cwd": ".",
            "platforms": ["linux"],
            "timeoutMs": 120000
          }
        ],
        "checkIds": [
          "tests",
          "legacy-compatibility",
          "build",
          "cli-smoke",
          "format",
          "lint",
          "typecheck",
          "repository-health",
          "dependency-audit"
        ]
      },
      {
        "id": "ubuntu-node-24",
        "platform": "linux",
        "toolchains": [
          {
            "kind": "node",
            "version": "24",
            "cache": "npm",
            "cacheDependencyPath": "package-lock.json"
          }
        ],
        "setup": [
          {
            "executable": "npm",
            "args": ["ci"],
            "cwd": ".",
            "platforms": ["linux"],
            "timeoutMs": 600000
          }
        ],
        "checkIds": ["tests", "build", "cli-smoke"]
      },
      {
        "id": "macos-node-24",
        "platform": "macos",
        "toolchains": [
          {
            "kind": "node",
            "version": "24",
            "cache": "npm",
            "cacheDependencyPath": "package-lock.json"
          }
        ],
        "setup": [
          {
            "executable": "npm",
            "args": ["ci"],
            "cwd": ".",
            "platforms": ["macos"],
            "timeoutMs": 600000
          }
        ],
        "checkIds": ["tests", "legacy-compatibility", "build", "cli-smoke"]
      },
      {
        "id": "windows-node-22",
        "platform": "windows",
        "toolchains": [
          {
            "kind": "node",
            "version": "22",
            "cache": "npm",
            "cacheDependencyPath": "package-lock.json"
          }
        ],
        "setup": [
          {
            "executable": "npm",
            "args": ["ci"],
            "cwd": ".",
            "platforms": ["windows"],
            "timeoutMs": 600000
          }
        ],
        "checkIds": ["tests", "legacy-compatibility", "build", "cli-smoke"]
      },
      {
        "id": "windows-node-24",
        "platform": "windows",
        "toolchains": [
          {
            "kind": "node",
            "version": "24",
            "cache": "npm",
            "cacheDependencyPath": "package-lock.json"
          }
        ],
        "setup": [
          {
            "executable": "npm",
            "args": ["ci"],
            "cwd": ".",
            "platforms": ["windows"],
            "timeoutMs": 600000
          }
        ],
        "checkIds": ["tests", "build", "cli-smoke"]
      },
      {
        "id": "windows-native-standard-user",
        "platform": "windows",
        "toolchains": [
          {
            "kind": "node",
            "version": "22",
            "cache": "npm",
            "cacheDependencyPath": "package-lock.json"
          }
        ],
        "setup": [
          {
            "executable": "npm",
            "args": ["ci"],
            "cwd": ".",
            "platforms": ["windows"],
            "timeoutMs": 600000
          }
        ],
        "checkIds": [
          "windows-supervisor-reproducibility",
          "windows-path-inspector-reproducibility",
          "windows-native-proof"
        ]
      }
    ],
    "requiredChecks": ["quality-gate", "policy-guard-source"],
    "requiredCodeScanning": [
      {
        "tool": "CodeQL",
        "alertsThreshold": "errors",
        "securityAlertsThreshold": "high_or_higher"
      }
    ],
    "immutableReleases": true,
    "securityFeatures": {
      "dependabotSecurityUpdates": true,
      "secretScanning": true,
      "secretScanningPushProtection": true
    }
  },
  "exceptions": {
    "p1": {
      "issueTemplate": ".github/ISSUE_TEMPLATE/quality-p1.yml",
      "maxDays": 30
    },
    "policy": {
      "issueTemplate": ".github/ISSUE_TEMPLATE/quality-policy.yml",
      "maxDays": 7
    }
  }
}

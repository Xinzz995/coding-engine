{
  "schemaVersion": 1,
  "codingXVersion": "0.33.3",
  "repository": {
    "provider": "github",
    "fullName": "Xinzz995/coding-engine",
    "defaultBranch": "main"
  },
  "release": {
    "protectedRefs": [
      "v*"
    ]
  },
  "sources": {
    "specs": [
      {
        "kind": "path",
        "path": "docs/specs/**"
      },
      {
        "kind": "pull-request"
      }
    ],
    "acceptanceCriteria": [
      {
        "kind": "pull-request"
      }
    ],
    "engineeringStandards": [
      "AGENTS.md",
      "docs/golden-principles.md",
      "docs/patterns.md",
      "docs/architecture.md"
    ]
  },
  "modules": [
    {
      "id": "root",
      "path": "."
    }
  ],
  "generatedPaths": [
    "dist/**",
    "coverage/**"
  ],
  "checks": {
    "test": {
      "checks": [
        {
          "id": "tests",
          "module": "root",
          "paths": [
            "src/**",
            "build/**",
            "hooks/**"
          ],
          "command": {
            "executable": "npm",
            "args": [
              "test",
              "--",
              "--run"
            ],
            "cwd": ".",
            "platforms": [
              "linux",
              "macos",
              "windows"
            ],
            "timeoutMs": 600000
          }
        }
      ]
    },
    "build": {
      "checks": [
        {
          "id": "build",
          "module": "root",
          "command": {
            "executable": "npm",
            "args": [
              "run",
              "build"
            ],
            "cwd": ".",
            "platforms": [
              "linux",
              "macos",
              "windows"
            ],
            "timeoutMs": 600000
          }
        },
        {
          "id": "cli-smoke",
          "module": "root",
          "command": {
            "executable": "node",
            "args": [
              "dist/cli.js",
              "--help"
            ],
            "cwd": ".",
            "platforms": [
              "linux",
              "macos",
              "windows"
            ],
            "timeoutMs": 60000
          }
        }
      ]
    },
    "static": {
      "checks": [
        {
          "id": "format",
          "module": "root",
          "paths": [
            "src/**",
            "build/**",
            "hooks/**",
            "*.ts",
            "*.js"
          ],
          "command": {
            "executable": "npm",
            "args": [
              "run",
              "format:check"
            ],
            "cwd": ".",
            "platforms": [
              "linux"
            ],
            "timeoutMs": 120000
          }
        },
        {
          "id": "lint",
          "module": "root",
          "paths": [
            "src/**",
            "eslint.config.js",
            "tsconfig.json"
          ],
          "command": {
            "executable": "npm",
            "args": [
              "run",
              "lint"
            ],
            "cwd": ".",
            "platforms": [
              "linux"
            ],
            "timeoutMs": 600000
          }
        },
        {
          "id": "typecheck",
          "module": "root",
          "paths": [
            "src/**",
            "tsconfig.json"
          ],
          "command": {
            "executable": "npm",
            "args": [
              "run",
              "typecheck"
            ],
            "cwd": ".",
            "platforms": [
              "linux",
              "macos",
              "windows"
            ],
            "timeoutMs": 600000
          }
        },
        {
          "id": "repository-health",
          "module": "root",
          "paths": [
            ".coding-x/**",
            ".github/ISSUE_TEMPLATE/**",
            ".github/PULL_REQUEST_TEMPLATE.md",
            ".github/workflows/**",
            "AGENTS.md",
            "README.md",
            "docs/**",
            "src/doctor/repository-health.test.ts"
          ],
          "command": {
            "executable": "npm",
            "args": [
              "run",
              "repository-health"
            ],
            "cwd": ".",
            "platforms": [
              "linux",
              "macos",
              "windows"
            ],
            "timeoutMs": 120000
          }
        }
      ]
    },
    "security": {
      "checks": [
        {
          "id": "dependency-audit",
          "module": "root",
          "command": {
            "executable": "npm",
            "args": [
              "audit",
              "--audit-level=high"
            ],
            "cwd": ".",
            "platforms": [
              "linux"
            ],
            "timeoutMs": 300000
          }
        }
      ]
    }
  },
  "risk": {
    "defaultCategories": [
      "policy",
      "public-contract",
      "state",
      "migration",
      "recovery",
      "idempotency",
      "concurrency",
      "timeout",
      "retry",
      "subprocess",
      "security",
      "privacy",
      "untrusted-input",
      "cross-module",
      "large-file",
      "reviewer-request",
      "release"
    ],
    "highRiskPaths": [
      ".coding-x/**",
      ".github/workflows/**",
      ".github/dependabot.yml",
      "src/engine/**",
      "src/quality/**",
      "src/doctor/**",
      "src/status/**",
      "src/report/**",
      "build/**",
      "hooks/**",
      "eslint.config.js",
      ".prettierrc.json",
      "package.json",
      "package-lock.json"
    ],
    "pathRules": [
      {
        "paths": [
          ".coding-x/**",
          ".github/workflows/**",
          ".github/dependabot.yml",
          "eslint.config.js",
          ".prettierrc.json",
          "docs/golden-principles.md",
          "src/doctor/repository-health.test.ts"
        ],
        "categories": [
          "policy",
          "security"
        ]
      },
      {
        "paths": [
          "src/engine/**"
        ],
        "categories": [
          "state",
          "recovery",
          "concurrency",
          "timeout",
          "retry",
          "subprocess"
        ]
      },
      {
        "paths": [
          "package.json",
          "package-lock.json",
          ".github/workflows/stage-candidate.yml",
          ".github/workflows/publish.yml"
        ],
        "categories": [
          "release",
          "security"
        ]
      }
    ]
  },
  "github": {
    "jobs": [
      {
        "id": "ubuntu-node-22",
        "platform": "linux",
        "toolchains": [
          {
            "kind": "node",
            "version": "22",
            "cache": "npm",
            "cacheDependencyPath": "package-lock.json"
          }
        ],
        "setup": [
          {
            "executable": "npm",
            "args": [
              "ci"
            ],
            "cwd": ".",
            "platforms": [
              "linux"
            ],
            "timeoutMs": 600000
          }
        ],
        "checkIds": [
          "tests",
          "build",
          "cli-smoke",
          "format",
          "lint",
          "typecheck",
          "repository-health",
          "dependency-audit"
        ]
      },
      {
        "id": "ubuntu-node-24",
        "platform": "linux",
        "toolchains": [
          {
            "kind": "node",
            "version": "24",
            "cache": "npm",
            "cacheDependencyPath": "package-lock.json"
          }
        ],
        "setup": [
          {
            "executable": "npm",
            "args": [
              "ci"
            ],
            "cwd": ".",
            "platforms": [
              "linux"
            ],
            "timeoutMs": 600000
          }
        ],
        "checkIds": [
          "tests",
          "build",
          "cli-smoke"
        ]
      },
      {
        "id": "macos-node-24",
        "platform": "macos",
        "toolchains": [
          {
            "kind": "node",
            "version": "24",
            "cache": "npm",
            "cacheDependencyPath": "package-lock.json"
          }
        ],
        "setup": [
          {
            "executable": "npm",
            "args": [
              "ci"
            ],
            "cwd": ".",
            "platforms": [
              "macos"
            ],
            "timeoutMs": 600000
          }
        ],
        "checkIds": [
          "tests",
          "build",
          "cli-smoke"
        ]
      },
      {
        "id": "windows-node-24",
        "platform": "windows",
        "toolchains": [
          {
            "kind": "node",
            "version": "24",
            "cache": "npm",
            "cacheDependencyPath": "package-lock.json"
          }
        ],
        "setup": [
          {
            "executable": "npm",
            "args": [
              "ci"
            ],
            "cwd": ".",
            "platforms": [
              "windows"
            ],
            "timeoutMs": 600000
          }
        ],
        "checkIds": [
          "tests",
          "build",
          "cli-smoke"
        ]
      }
    ],
    "requiredChecks": [
      "quality-gate",
      "policy-guard-source"
    ],
    "requiredCodeScanning": [
      {
        "tool": "CodeQL",
        "alertsThreshold": "errors",
        "securityAlertsThreshold": "high_or_higher"
      }
    ],
    "immutableReleases": true,
    "securityFeatures": {
      "dependabotSecurityUpdates": true,
      "secretScanning": true,
      "secretScanningPushProtection": true
    }
  },
  "exceptions": {
    "p1": {
      "issueTemplate": ".github/ISSUE_TEMPLATE/quality-p1.yml",
      "maxDays": 30
    },
    "policy": {
      "issueTemplate": ".github/ISSUE_TEMPLATE/quality-policy.yml",
      "maxDays": 7
    }
  }
}

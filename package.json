{
  "name": "coding-x",
  "version": "0.30.9",
  "description": "Ralph auto-coding harness — Developer/Validator loop engine + Claude Code plugin",
  "license": "MIT",
  "author": "Xinzz",
  "type": "module",
  "keywords": [
    "ralph",
    "ai-coding",
    "autonomous-agent",
    "harness",
    "claude",
    "codex",
    "prd",
    "cli"
  ],
  "homepage": "https://github.com/Xinzz995/coding-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xinzz995/coding-engine.git"
  },
  "bugs": {
    "url": "https://github.com/Xinzz995/coding-engine/issues"
  },
  "bin": {
    "coding-x": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"build/**/*.mjs\" \"hooks/**/*.mjs\" tsup.config.ts eslint.config.js --max-warnings=0",
    "version": "node build/sync-plugin-versions.mjs && git add .claude-plugin/plugin.json .cursor-plugin/plugin.json .codex-plugin/plugin.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "jsonrepair": "3.14.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^20.11.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}

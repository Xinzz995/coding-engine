{
  "name": "coding-x",
  "version": "0.34.1",
  "description": "Ralph auto-coding harness — Developer/Validator loop engine + Claude Code plugin",
  "license": "MIT",
  "author": "Xinzz",
  "type": "module",
  "keywords": [
    "ralph",
    "ai-coding",
    "autonomous-agent",
    "harness",
    "claude",
    "codex",
    "prd",
    "cli"
  ],
  "homepage": "https://github.com/Xinzz995/coding-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xinzz995/coding-engine.git"
  },
  "bugs": {
    "url": "https://github.com/Xinzz995/coding-engine/issues"
  },
  "bin": {
    "coding-x": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "format": "node build/check-format.mjs --write --base origin/main",
    "format:check": "node build/check-format.mjs --base origin/main",
    "lint": "eslint src",
    "repository-health": "vitest run src/doctor/repository-health.test.ts",
    "test": "vitest run",
    "test:legacy-compat": "tsx src/workspace-safety/legacy-compatibility-ci.ts",
    "test:windows-native-proof": "pwsh -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File build/run-windows-native-proof.ps1",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version": "node build/sync-plugin-versions.mjs && git add .claude-plugin/plugin.json .cursor-plugin/plugin.json .codex-plugin/plugin.json src/version.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "jsonrepair": "^3.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "tsup": {
      "esbuild": "0.28.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}

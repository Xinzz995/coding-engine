{
  "description": "Run the project TDD coverage gate before agent commits.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/tdd-commit-check.mjs\"",
            "timeout": 620,
            "statusMessage": "Running TDD coverage gate"
          }
        ]
      }
    ]
  }
}
